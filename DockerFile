# ── Stage 1: Build frontend ───────────────────────────────────────────────────
FROM node:22-alpine AS frontend
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# ── Stage 2: Build backend ────────────────────────────────────────────────────
FROM gradle:9.7.1-jdk21 AS backend
WORKDIR /app
COPY ai-service/build.gradle ai-service/settings.gradle ./
RUN gradle --no-daemon dependencies || true
COPY ai-service/src ./src
# Embed built frontend into Spring Boot static resources
COPY --from=frontend /app/dist ./src/main/resources/static
RUN gradle bootJar --no-daemon -x test

# ── Stage 3: Runtime ──────────────────────────────────────────────────────────
FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=backend /app/build/libs/*.jar app.jar
# Make Excel template accessible as a plain file (used by ExcelCalculationService)
COPY --from=backend /app/src/main/resources/test_results1.xlsx ./
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
